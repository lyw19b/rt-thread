# Description:
#   Compile the board-owned i2c driver.

from building import *

cwd = GetCurrentDir()
group = DefineGroup('LS2K3000 i2c', Glob('*.c'),
                    depend=['BSP_USING_LS2K3000_I2C'], CPPPATH=[cwd],
                    LOCAL_CCFLAGS=['-Wall', '-Wextra', '-Werror',
                                   '-Wno-ignored-qualifiers'])
Return('group')

# Description:
#   Keep each board device in its own directory.

from building import *
import rtconfig

cwd = GetCurrentDir()
group = DefineGroup('LS2K3000 interfaces', [], depend=[''],
                    CPPPATH=[os.path.join(cwd, 'boards'),
                             os.path.join(cwd, '..', 'boot'),
                             os.path.join(cwd, 'pcie')])

for directory in ('boards', 'display', 'pcie', 'storage', 'sd', 'net', 'power',
                  'i2c', 'spi', 'rtc', 'gpio', 'pwm', 'timer', 'usb'):
    group += SConscript(os.path.join(directory, 'SConscript'))

if GetDepend('BSP_USING_USB_CAMERA'):
    camera_dir = os.environ.get('LS2K3000_CAMERA_DIR',
        os.path.abspath(os.path.join(rtconfig.RTT_ROOT, '..', '..', 'driver', 'rtos', 'camera')))
    group += SConscript(os.path.join(camera_dir, 'SConscript'),
                        variant_dir='camera', duplicate=0)

if GetDepend('BSP_USING_NOVAUI'):
    ui_dir = os.environ['NOVAUI_RTOS_DIR']
    # The board starts the embedded ELF from ROMFS instead of copying it to tmpfs.
    VariantDir('novaui', ui_dir, duplicate=0)
    ui_sources = ['novaui/display_service.c']

    if GetDepend('BSP_NOVAUI_SINGLE_BUFFER'):
        ui_sources += ['novaui/frame_copy.c']

    if GetDepend('BSP_USING_SELFTEST'):
        ui_sources += ['novaui/thread_probe.c']

    ui_flags = ['-Wall', '-Wextra', '-Wno-unused-parameter', '-Wno-ignored-qualifiers']

    if GetDepend('BSP_NOVAUI_GOP_WRITE64'):
        ui_flags += ['-DNOVAUI_FRAMEBUFFER_WRITE64']

    group += DefineGroup('LS2K3000 NovaUI service', ui_sources,
                         depend=['BSP_USING_NOVAUI'], CPPPATH=[ui_dir],
                         LOCAL_CCFLAGS=ui_flags)
    group += SConscript(os.path.join(ui_dir, '../../src/measure/cpu/SConscript'),
                        variant_dir='novaui/cpu-measure', duplicate=0)

Return('group')

# Description:
#   Compile the board-owned timer driver.

from building import *

cwd = GetCurrentDir()
group = DefineGroup('LS2K3000 timer', Glob('*.c'),
                    depend=['BSP_USING_LS2K3000_HPET'], CPPPATH=[cwd],
                    LOCAL_CCFLAGS=['-Wall', '-Wextra', '-Werror',
                                   '-Wno-ignored-qualifiers'])
Return('group')

# Description:
#   Build the board-owned polling xHCI transport and HID mouse adapter.

from building import *

cwd = GetCurrentDir()
group = DefineGroup('LS2K3000 USB mouse', Glob('*.c'),
                    depend=['BSP_USING_USB_MOUSE'], CPPPATH=[cwd],
                    LOCAL_CCFLAGS=['-Wall', '-Wextra', '-Werror', '-Wno-ignored-qualifiers'])
Return('group')

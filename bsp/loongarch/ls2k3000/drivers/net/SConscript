# Description:
#   Reuse the board-family GMAC engine with an Explorer-owned lwIP adapter.

from building import *

Import('RTT_ROOT')

cwd = GetCurrentDir()
core = os.path.join(RTT_ROOT, 'bsp', 'loongarch', 'common', 'gmac')
group = DefineGroup('LS2K3000 Ethernet', ['drv_gmac.c', os.path.join(core, 'gmac.c')],
                    depend=['BSP_USING_LS2K3000_GMAC'], CPPPATH=[cwd, core],
                    LOCAL_CCFLAGS=['-Wall', '-Wextra', '-Werror', '-Wno-ignored-qualifiers'])
Return('group')

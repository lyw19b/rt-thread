from building import *

cwd = GetCurrentDir()
group = DefineGroup('LS2K3000 boards', Glob('*.c'), depend=[''], CPPPATH=[cwd],
                    LOCAL_CCFLAGS=['-Wall', '-Wextra', '-Werror',
                                   '-Wno-ignored-qualifiers'])
Return('group')

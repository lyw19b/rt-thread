# File: Kconfig
# Author: LoongsonLab
#
# Description:
#   Configure UEFI boot and board-owned LS2K3000 drivers.

mainmenu "RT-Thread LS2K3000 Explorer Configuration"
BSP_DIR := .
RTT_DIR := ../../..
PKGS_DIR := packages

source "$(RTT_DIR)/Kconfig"
osource "$PKGS_DIR/Kconfig"

config BSP_LS2K3000
    bool
    default y
    select ARCH_LOONGARCH64
    select ARCH_LOONGARCH_FPU
    select RT_USING_COMPONENTS_INIT
    select RT_USING_USER_MAIN
    select RT_USING_CACHE
    select ARCH_MM_MMU if RT_USING_SMART
    select ARCH_REMAP_KERNEL if RT_USING_SMART

config RT_CPUS_NR
    range 1 8 if RT_USING_SMP
    default 1 if RT_USING_SMP

config __STACKSIZE__
    int "Boot and per-CPU stack bytes"
    default 16384

config BSP_UART_CLOCK_HZ
    int "UART0 input clock (Hz)"
    default 100000000
    range 1000000 500000000

config BSP_USING_UEFI_FRAMEBUFFER
    bool "Retain firmware GOP scanout"
    default y
    help
        Register an existing linear 32-bit RGB/BGR framebuffer as lcd.
        HDMI mode setting remains owned by firmware before handoff.
        BLT-only modes and unsupported pixel formats are rejected.

config BSP_USING_BOOT_SCREEN
    bool "Show kernel startup status and display checks"
    depends on BSP_USING_UEFI_FRAMEBUFFER && !BSP_USING_NOVAUI
    default y
    help
        Render startup status, resolution, color bars and the full screen border
        into the firmware framebuffer. Keeps the current HDMI/display mode.

config BSP_USING_PCI_INVENTORY
    bool "Inspect firmware PCI resources"
    default y

config BSP_USING_DMA_POOL
    bool

config BSP_USING_NVME
    bool "NVMe SSD (one namespace, polled queues)"
    select BSP_USING_DMA_POOL
    select BSP_USING_PCI_INVENTORY
    select RT_USING_MUTEX
    select RT_USING_DEVICE_OPS
    default n
    help
        Uses firmware PCI resources and dedicated uncached DMA storage.
        Supports 512-byte and 4 KiB sectors with bounded synchronous commands.
        Does not format or automatically mount any disk. MSI is not required.

config BSP_NVME_ALLOW_WRITE
    bool "Allow explicit NVMe block writes"
    depends on BSP_USING_NVME
    default n


config BSP_USING_LS2K3000_MMC
    bool "Native SD/eMMC memory host"
    select RT_USING_SDIO
    select BSP_USING_DMA_POOL
    select BSP_USING_PCI_INVENTORY
    select RT_USING_MUTEX
    select RT_USING_SEMAPHORE
    default n
    help
        Board-owned synchronous DMA driver for the native LS2K3000 controller.
        Supports SD memory (1/4-bit) and eMMC user area (1/4/8-bit) in SDR mode.
        Does not advertise HS200, HS400, DDR, SDIO function IRQs or hot removal.
        Firmware supplies pad mux, card power and clocks. No automatic mounting.

if BSP_USING_LS2K3000_MMC

config BSP_LS2K3000_MMC_INPUT_HZ
    int "Verified SD/eMMC controller input clock (Hz; 0 disables initialization)"
    range 0 409200000
    default 0
    help
        Must match the firmware clock feeding the native prescaler. Do not use
        the CPU or UART clock. Zero deliberately prevents guessing a frequency.

config BSP_LS2K3000_MMC_MAX_HZ
    int "Maximum SDR card clock (Hz)"
    range 400000 25000000
    default 25000000

config BSP_LS2K3000_MMC_ALLOW_WRITE
    bool "Allow SD/eMMC user-area block writes"
    default n
    help
        Disabled for initial bring-up. The installed eMMC contains Linux and
        its EFI partition. Enabling this does not format or mount any partition.

config BSP_LS2K3000_MMC_ACPI_STATIC
    bool "Use explicit ACPI resources when firmware hides the PCI functions"
    default n
    help
        Use only with resource addresses verified from this board's ACPI _CRS.
        PCI enumeration takes precedence when the native functions are visible.
        Current Explorer firmware exposed eMMC at 0x79990000 and SD at 0x79991000
        in Linux /proc/iomem. Addresses default to zero to avoid stale mappings.

config BSP_LS2K3000_EMMC_BASE
    hex "Verified ACPI eMMC MMIO base (0 skips)"
    depends on BSP_LS2K3000_MMC_ACPI_STATIC
    default 0

config BSP_LS2K3000_SD_BASE
    hex "Verified ACPI SD MMIO base (0 skips)"
    depends on BSP_LS2K3000_MMC_ACPI_STATIC
    default 0

endif

config BSP_USING_LS2K3000_GMAC
    bool "Native GMAC2 Ethernet (polled DMA)"
    depends on RT_USING_LWIP
    select BSP_USING_DMA_POOL
    select BSP_USING_PCI_INVENTORY
    select RT_USING_MUTEX
    select RT_USING_DEVICE_OPS
    default n

config BSP_LS2K3000_MDIO_CLOCK
    int "GMAC MDC divider encoding (verify CSR input clock)"
    depends on BSP_USING_LS2K3000_GMAC
    range 0 5
    default 4
    help
        Encoding 4 divides the CSR clock by 102 (150-250 MHz range).
        Verify the actual CSR clock before hardware validation.

osource "$NOVAUI_RTOS_DIR/Kconfig"

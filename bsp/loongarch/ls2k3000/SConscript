# Description:
#   Select the board drivers and application.

from building import *

group = SConscript('drivers/SConscript')
group += SConscript('applications/SConscript')
group += DefineGroup('LS2K3000 firmware contract', ['boot/boot_contract.c'], depend=[''])
Return('group')

from building import *
Import('RTT_ROOT')

# Keep objects for different BSP configurations out of the shared source tree.
VariantDir('port_tests', os.path.join(RTT_ROOT, 'examples/test'), duplicate=0)

src = Glob('*.c')
if GetDepend('BSP_USING_SELFTEST'):
    src += ['port_tests/loongarch_kernel_test.c', 'port_tests/loongarch_smp_test.c']
    if GetDepend('RT_USING_SMART'):
        src += ['port_tests/loongarch_kernel_map_test.c']
if GetDepend('BSP_GMAC_USING_ECHO_TEST'):
    src += ['port_tests/ls2k_gmac_echo.c']
if GetDepend('BSP_SDIO_USING_FILE_TEST'):
    src += ['port_tests/ls2k_sd_filetest.c']
group = DefineGroup('Applications', src, depend=[''])
Return('group')

# Description:
#   LS2K0300 development BSP: SConstruct.

import os
import shutil

# Seed an explicit profile on a fresh checkout; configuration stays local.
if not os.path.exists('.config'):
    shutil.copyfile('config/rtt_defconfig', '.config')

# Keep SCons paths relative to this BSP while sharing the build setup.

with open('../common/build.py') as source:
    exec(compile(source.read(), '../common/build.py', 'exec'))

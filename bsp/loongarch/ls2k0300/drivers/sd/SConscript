import os
import rtconfig
from building import *

cwd = GetCurrentDir()
sources = Glob('*.c')

if GetDepend('BSP_SDIO_USING_BLOCK_TEST'):
    sources += [os.path.join(rtconfig.RTT_ROOT, 'examples/test/ls2k_sdio_block_test.c')]

group = DefineGroup('LS2K0300 SD', sources, depend=['BSP_USING_SDIO'],
                    CPPPATH=[cwd], LOCAL_CCFLAGS=['-Wall', '-Wextra', '-Werror', '-Wno-ignored-qualifiers'])
Return('group')

# Description:
#   Compile only the selected vanguard board adapters.

from building import *

cwd = GetCurrentDir()
group = []

if GetDepend('BSP_USING_VANGUARD') or GetDepend('BSP_USING_VANGUARD_TOUCH'):
    group = DefineGroup('LS2K0300 vanguard', Glob('*.c'), depend=[],
                        CPPPATH=[cwd],
                        LOCAL_CCFLAGS=['-Wall', '-Wextra', '-Werror', '-Wno-ignored-qualifiers'])

Return('group')

from building import *

cwd = GetCurrentDir()
src = Glob('*.c')
# The shared mach/common implementation owns LIOINTC initialization.
SrcRemove(src, ['drv_interrupt.c'])
group = DefineGroup('LS2K0300 board adaptation', src, depend=[''], CPPPATH=[cwd],
                    LOCAL_CCFLAGS=['-Wall', '-Wextra', '-Werror', '-Wno-ignored-qualifiers'])
Return('group')

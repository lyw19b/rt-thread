# Description:
#   LS2K0300 development BSP: SConscript.

from building import *
import rtconfig

cwd = GetCurrentDir()
# Board interfaces are shared by the selected peripherals and project adapters.
group = DefineGroup('LS2K0300 board interfaces', [], depend=[''],
                    CPPPATH=[os.path.join(cwd, name) for name in ('boards', 'usb', 'sd', 'power')])

for directory in ('boards', 'power', 'usb', 'sd', 'bsp', 'gpio', 'adc', 'i2c',
                  'pwm', 'rtc', 'spi', 'thermal', 'watchdog', 'ssd1306'):
    group = group + SConscript(os.path.join(directory, 'SConscript'))

if GetDepend('BSP_USING_LAXPU'):
    driver_dir = os.path.abspath(os.path.join(rtconfig.RTT_ROOT,
                                            '..', '..', 'driver', 'rtos'))
    group = group + SConscript(os.path.join(driver_dir, 'SConscript'),
                       variant_dir='openlanpu', duplicate=0)

if GetDepend('BSP_USING_USB_CAMERA'):
    camera_dir = os.path.abspath(os.path.join(rtconfig.RTT_ROOT,
                                            '..', '..', 'driver', 'rtos', 'camera'))
    group = group + SConscript(os.path.join(camera_dir, 'SConscript'),
                       variant_dir='camera', duplicate=0)

if GetDepend('BSP_USING_SYSTEMUI'):
    ui_dir = os.path.abspath(os.path.join(rtconfig.RTT_ROOT,
                                        '..', '..', 'display', 'systemui'))
    group = group + SConscript(os.path.join(ui_dir, 'SConscript'),
                        variant_dir='systemui', duplicate=0)

Return('group')

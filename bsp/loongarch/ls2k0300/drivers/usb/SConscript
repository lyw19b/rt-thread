# Description:
#   LS2K0300 development BSP: SConscript.

from building import *
import rtconfig

cwd = GetCurrentDir()
src = Glob('*.c')
if not GetDepend('BSP_USING_USB_CAMERA'):
    SrcRemove(src, ['ls2k_ehci_iso.c'])

group = DefineGroup('LS2K0300 USB host', src, depend=['BSP_USING_USB_HOST'],
                    CPPPATH=[cwd],
                    LOCAL_CCFLAGS=['-Wall', '-Wextra', '-Werror', '-Wno-ignored-qualifiers'],
                    LOCAL_CPPDEFINES=['LS2K_EHCI_CAMERA'] if GetDepend('BSP_USING_USB_CAMERA') else [])

if GetDepend('BSP_USING_USB_HOST'):
    usb = os.path.join(rtconfig.RTT_ROOT, 'components/drivers/usb/cherryusb')
    usb_paths = [cwd] + [os.path.join(usb, name) for name in
                        ['common', 'core', 'class/hub', 'class/msc']]
    usb_sources = [os.path.join(usb, name) for name in
                   ['core/usbh_core.c', 'class/hub/usbh_hub.c', 'class/msc/usbh_msc.c']]
    group = group + DefineGroup('LS2K0300 USB stack', usb_sources, depend=['BSP_USING_USB_HOST'],
                         CPPPATH=usb_paths)
    # Keep the shared OSAL source unchanged; replace only the board's critical
    # sections and millisecond timer creation with SMP/tick-correct adapters.
    group = group + DefineGroup('LS2K0300 USB OSAL', [os.path.join(usb, 'osal/usb_osal_rtthread.c')],
                         depend=['BSP_USING_USB_HOST'], CPPPATH=usb_paths,
                         LOCAL_CPPDEFINES=[
                             ('usb_osal_enter_critical_section', 'ls2k_usb_local_irq_enter'),
                             ('usb_osal_leave_critical_section', 'ls2k_usb_local_irq_leave'),
                             ('usb_osal_timer_create', 'ls2k_usb_raw_tick_timer_create')])

Return('group')

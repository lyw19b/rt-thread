from building import *

cwd = GetCurrentDir()
src = Glob('*.c')
group = DefineGroup('LS2K0300 ADC', src,
                    depend=['BSP_DEV_ADC'], CPPPATH=[cwd],
                    LOCAL_CCFLAGS=['-Werror=implicit-function-declaration',
                                   '-Werror=incompatible-pointer-types'])
Return('group')

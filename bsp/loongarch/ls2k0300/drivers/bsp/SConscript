# Description:
#   LS2K0300 development BSP: SConscript.

from building import *

cwd = GetCurrentDir()
src = ['bsp_pinmux.c', 'bsp_clock.c']
if GetDepend('BSP_DEV_THERMAL'):
    src += ['bsp_thermal.c']
if GetDepend('BSP_DEV_SPI'):
    src += ['bsp_dma.c', 'bsp_dma_map.c']
group = DefineGroup('LS2K0300 peripheral helpers', src,
                    depend=['BSP_LS2K0300'], CPPPATH=[cwd],
                    LOCAL_CCFLAGS=['-Werror=implicit-function-declaration'])
Return('group')

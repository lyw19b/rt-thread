# for module compiling
import os
from building import *
Import('RTT_ROOT')

cwd  = GetCurrentDir()
objs = []
list = os.listdir(cwd)

for d in list:
    path = os.path.join(cwd, d)
    if os.path.isfile(os.path.join(path, 'SConscript')):
        objs = objs + SConscript(os.path.join(d, 'SConscript'))

# Compile shared drivers into this BSP's own build directory.
objs += SConscript(os.path.join(RTT_ROOT, 'bsp/loongarch/common/SConscript'),
                    variant_dir='common', duplicate=0)
Return('objs')

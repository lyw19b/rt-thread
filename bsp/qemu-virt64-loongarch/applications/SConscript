from building import *
Import('RTT_ROOT')

# Keep objects for different BSP configurations out of the shared source tree.
VariantDir('port_tests', os.path.join(RTT_ROOT, 'examples/test'), duplicate=0)

cwd     = GetCurrentDir()
src = Glob('*.c') + Glob('*.cpp')
if GetDepend('BSP_USING_SELFTEST'):
    src += ['port_tests/loongarch_kernel_test.c', 'port_tests/loongarch_smp_test.c',
            'port_tests/loongarch_unaligned_test.c']
CPPPATH = [cwd]

group = DefineGroup('Applications', src, depend = [''], CPPPATH = CPPPATH)

objs = [group]

list = os.listdir(cwd)

for item in list:
    if os.path.isfile(os.path.join(cwd, item, 'SConscript')):
        objs = objs + SConscript(os.path.join(item, 'SConscript'))

Return('objs')

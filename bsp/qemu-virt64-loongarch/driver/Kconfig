menu "LoongArch QEMU virt64 configs"

config BSP_USING_VIRTIO
    bool "Using VirtIO"
    default n
    depends on RT_USING_DEVICE_OPS && !RT_USING_NANO

config BSP_USING_VIRTIO_BLK
    bool "Using VirtIO BLK"
    default y
    select RT_USING_LEGACY_VIRTIO
    select RT_USING_VIRTIO_BLK
    default n
    depends on BSP_USING_VIRTIO

config BSP_USING_VIRTIO_NET
    bool "Using VirtIO NET"
    select RT_USING_LEGACY_VIRTIO
    select RT_USING_VIRTIO_NET
    default n
    depends on BSP_USING_VIRTIO

config BSP_USING_VIRTIO_CONSOLE
    bool "Using VirtIO Console"
    select RT_USING_LEGACY_VIRTIO
    select RT_USING_VIRTIO_CONSOLE
    default n
    depends on BSP_USING_VIRTIO

config BSP_USING_VIRTIO_GPU
    bool "Using VirtIO GPU"
    select RT_USING_LEGACY_VIRTIO
    select RT_USING_VIRTIO_GPU
    default n
    depends on BSP_USING_VIRTIO

config BSP_USING_VIRTIO_INPUT
    bool "Using VirtIO Input"
    select RT_USING_LEGACY_VIRTIO
    select RT_USING_VIRTIO_INPUT
    default n
    depends on BSP_USING_VIRTIO

endmenu

config BSP_USING_RAMDISK
    bool "RAM disk at physical address 0x0c000000 (64 MiB)"
    depends on RT_USING_DFS && !RT_USING_NANO
    default y
    help
        Load a FAT image with QEMU's generic loader before starting the CPU.
        The upper 64 MiB of guest RAM are reserved for this disk.

# RT-Thread building script for bridge

import os
from building import *

group = SConscript(os.path.join('common', 'SConscript'))

if GetDepend('BSP_LS2K1000LA') or GetDepend('BSP_LS2K0300'):
    group = group + SConscript(os.path.join('mach', 'SConscript'))

Return('group')

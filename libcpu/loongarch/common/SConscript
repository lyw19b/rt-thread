# RT-Thread building script for component

from building import *

Import('rtconfig')
Import('RTT_ROOT')

cwd     = GetCurrentDir()
src     = Glob('*.c') + Glob('*.cpp') + Glob('*_gcc.S')
CPPPATH = [cwd, cwd + '/include']

if not GetDepend('RT_USING_SMART'):
    SrcRemove(src, ['mmu.c'])

group = DefineGroup('libcpu', src, depend = [''], CPPPATH = CPPPATH)

Return('group')

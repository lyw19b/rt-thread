menu "RT-Thread LoongArch CPU"

    choice
        prompt "Kernel address mapping"
        default KMD_USE_DMW

    config KMD_USE_DMW
        bool "Direct mapping windows (DMW)"

    config KMD_USE_PAGE
        bool "High-address kernel with 4 KiB page tables"
        depends on RT_USING_SMART && SOC_LS2K0300
        help
            Build the kernel mappings before entering paged mode. All DMW
            windows remain disabled. Kernel RAM and devices use high virtual
            addresses; user pointers and DMA addressing are unchanged.

    endchoice

    config RT_USING_FPU
        bool
        default y
        help
            Using Float Point Unit in code.

    config LOONGARCH_HAS_HARDWARE_PTW
        bool

    choice
        prompt "Smart TLB refill"
        depends on RT_USING_SMART
        default LOONGARCH_SOFTWARE_PTW

    config LOONGARCH_SOFTWARE_PTW
        bool "Software TLB refill"

    config LOONGARCH_HARDWARE_PTW
        bool "Hardware page table walk"
        depends on LOONGARCH_HAS_HARDWARE_PTW
        help
            Requires CPUCFG2.PTW and a CPU implementing the hardware walker.
            LS2K0300 and LS2K1000LA use software refill only.

    endchoice

endmenu
